# Authentification privée du Dashboard Pokémon GO
ADMIN_EMAIL=matthieu@example.com
ADMIN_PASSWORD=change-moi
SESSION_SECRET=change-moi-en-production

# Base du Dashboard Pokémon GO
# DASHBOARD_MONGODB_URI est prioritaire ; MONGODB_URI reste un alias compatible.
MONGODB_URI=
DASHBOARD_MONGODB_URI=
DASHBOARD_MONGODB_DB=matweb-dashboard-admin
# Collections : dashboard_store, dashboard_api_metrics, events, events_archive,
# community_days, community_days_archive et dataset_runs.

# Statistiques Pokémon GO API
POKEMON_API_URL=https://pokemon-go-7r5q2j05a-matthieu-vachets-projects.vercel.app/api/checklist-v3
POKEMON_API_PUBLIC_URL=https://pokemon-go-api.vercel.app

# Liaison serveur-à-serveur facultative vers le contrat opérationnel du bot Discord.
# Le Dashboard affiche explicitement les métriques comme indisponibles si elle manque.
# En local : http://127.0.0.1:3210/v1/overview. En production : URL HTTPS privée réelle.
# DISCORD_BOT_OPERATIONS_URL=https://bot-interne.example.com/v1/overview
# DISCORD_BOT_OPERATIONS_SECRET=replace-with-the-same-32-character-secret-as-the-bot
# Optionnel : même valeur que API_ADMIN_SECRET dans le projet PokemonGo-API.
# Requis seulement si le dashboard appelle une route privée PokemonGo-API.
POKEMON_API_ADMIN_SECRET=

# Admin Pokémon GO
# Optionnel en local si PokemonGo-Data n'est ni dans .data/ ni dans le dossier voisin.
# Ne pas définir un chemin de machine sur Vercel : le prebuild crée .data/PokemonGo-Data.
POKEMON_GO_DATA_DIR=../PokemonGo-Data
POKEMON_GO_DATA_REPO=https://github.com/Matthieu-Vachet/PokemonGo-Data.git
POKEMON_GO_DATA_REF=main
# Obligatoire sur Vercel si le repo PokemonGo-Data est privé
POKEMON_GO_DATA_TOKEN=
