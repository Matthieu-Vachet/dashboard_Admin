{
  "name": "dashboard-admin",
  "version": "1.36.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "validate:learning": "node --no-warnings --experimental-strip-types scripts/validate-learning.mjs",
    "prebuild": "npm run validate:learning && node scripts/data/ensure-data.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --pretty false",
    "test:admin-pokemon": "node --test scripts/test-admin-pokemon-refactor.mjs",
    "test:pokemon-variants": "node --no-warnings --experimental-strip-types --test scripts/test-pokemon-variant-resolver.mjs",
    "test:pokemon-presentation": "node --test scripts/test-pokemon-presentation-entries.mjs",
    "test:trainer-pokemon": "node --no-warnings --experimental-strip-types --test scripts/test-trainer-pokemon.mjs",
    "test:learning-flow": "node scripts/test-learning-flow.mjs",
    "test:event-references": "tsx --test scripts/test-persistent-event-references.mts",
    "test:version": "node scripts/test-dashboard-version.mjs",
    "test:pokemon-responsive": "node scripts/verify-pokemon-responsive.mjs",
    "test:pvp-gbl": "node --test scripts/test-pvp-gbl-display.mjs",
    "test:pvp-engine": "tsx --test scripts/test-pvp-battle-engine.mts",
    "test:pvp-parity": "node --conditions=react-server --import tsx --test scripts/test-pvp-parity.mts",
    "test:design-system": "node --test scripts/test-design-system-*.mjs scripts/test-form-accessibility.mjs",
    "test:design-system-state-system": "node --test scripts/test-design-system-state-system.mjs",
    "check": "npm run lint && npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-slot": "^1.2.4",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.26",
    "geist": "^1.7.2",
    "gsap": "^3.15.0",
    "lucide-react": "^0.561.0",
    "mongodb": "^7.3.0",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.5.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "latest",
    "playwright": "^1.61.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
